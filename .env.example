DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
PORT=3001

# Email notifications (optional) — leave unset to log emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Socia <notifications@yourdomain.com>"
# Comma-separated fallback recipient(s) for admin approval-needed emails, used alongside any admins.email values.
ADMIN_NOTIFICATION_EMAIL=
